<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/fundo_lavanda">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FinanSee"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/roxo_escuro"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seu dinheiro, seu controle."
        android:textSize="16sp"
        android:textColor="@color/pink_barbie"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bem-vindo ao FinanSee!"
        android:textSize="23sp"
        android:textStyle="bold"
        android:textColor="@color/roxo_escuro"
        android:gravity="center"
        android:layout_marginTop="70dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Organize suas receitas, despesas e acompanhe sua vida financeira."
        android:textSize="16sp"
        android:textColor="#555555"
        android:gravity="center"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnMovimentacoes"
        android:layout_width="353dp"
        android:layout_height="49dp"
        android:layout_marginTop="45dp"
        android:text="Minhas movimentações"
        android:backgroundTint="@color/lilas"
        android:textColor="@color/branco"/>

    <Button
        android:id="@+id/btnEducacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Educação financeira"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/lilas"
        android:textColor="@color/branco"/>

</LinearLayout>
