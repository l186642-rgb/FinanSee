<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_lavanda">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nova movimentação"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/pink_barbie"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/txtSaldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saldo atual: R$ 0,00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/pink_barbie"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descrição"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/edtDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex.: Compra no mercado"
            android:inputType="textCapSentences"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/rosa_bebe"
            android:textColor="@color/roxo_escuro"
            android:textColorHint="@color/lilas"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valor (R$)"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/edtValor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0,00"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de movimentação"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <RadioGroup
            android:id="@+id/rgTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbReceita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Receita"
                android:textColor="@color/roxo_escuro"
                android:buttonTint="@color/pink_barbie"/>

            <RadioButton
                android:id="@+id/rbDespesa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Despesa"
                android:textColor="@color/roxo_escuro"
                android:buttonTint="@color/pink_barbie"/>

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categoria"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <Spinner
            android:id="@+id/spCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/lilas"
            android:popupBackground="@color/rosa_bebe"/>

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar movimentação"
            android:backgroundTint="@color/pink_barbie"
            android:textColor="@color/branco"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Histórico de movimentações"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#234F3B"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtListaVazia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nenhuma movimentação cadastrada."
            android:textColor="@color/roxo_escuro"
            android:background="@color/rosa_bebe"
            android:padding="12dp"
            android:textSize="16sp"
            android:gravity="center"/>

    </LinearLayout>

</ScrollView>
